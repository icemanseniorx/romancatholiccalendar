TRIGGER;VALUE=DATE-TIME:20260626T100000Z
ACTION:DISPLAY
DESCRIPTION:COMPLETE ABSTINENCE TODAY — Ss. John & Paul\, Mm (d)
END:VALARM
END:VEVENT
